# Panel Aleksander (kopia PHP) — routing przez front controller index.php.
# DocumentRoot Apache powinien wskazywac na ten katalog (public/).

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Istniejace pliki (index.html, statyczne zasoby) serwujemy bezposrednio.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Reszta (w tym /api/*, /export.csv) trafia do front controllera.
    RewriteRule ^ index.php [L]
</IfModule>

# Domyslny dokument.
DirectoryIndex index.php index.html

# Nie listuj katalogow.
Options -Indexes
