# Warstwa wizualna — DocumentRoot Apache powinien wskazywać na ten katalog (ui/).
# Wszystko trafia do front controllera index.php (on serwuje UI, statyki i deleguje /api/* do silnika).

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
    RewriteRule ^ index.php [L]
</IfModule>

DirectoryIndex index.php index.html
Options -Indexes

# paths.php to tylko konfiguracja ścieżek — nie wywołujemy go bezpośrednio.
<Files "paths.php">
    Require all denied
</Files>
