# Warstwa wizualna — DocumentRoot Apache powinien wskazywać na ten katalog (ui/).
# Wszystko trafia do front controllera index.php (on serwuje UI, statyki i deleguje /api/* do silnika).

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Naglowek Authorization (klucz wysylki nocy z serwera domowego) — czesc hostingow (PHP-FPM/CGI)
    # go obcina; przekazujemy go do PHP jako HTTP_AUTHORIZATION.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
    RewriteRule ^ index.php [L]
</IfModule>

DirectoryIndex index.php index.html
Options -Indexes

# paths.php to tylko konfiguracja ścieżek — nie wywołujemy go bezpośrednio.
<Files "paths.php">
    Require all denied
</Files>
